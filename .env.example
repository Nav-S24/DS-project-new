# Frontend Environment Configuration (leave empty for automatic relative routing in dev & Cloud Run)
VITE_API_BASE_URL=

# Backend General Settings
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_db

# gRPC Microservices Networking & Ports
AMBULANCE_GRPC_HOST=localhost:50051
HOSPITAL_GRPC_HOST=localhost:50052

# gRPC Deadlines and Fault Tolerances
RPC_DEADLINE_SECONDS=3.0
RPC_MAX_RETRIES=2
ALLOW_INPROCESS_FALLBACK=true

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE=emergency_events
RABBITMQ_QUEUE=emergency_service_queue
